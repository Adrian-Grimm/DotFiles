#!/usr/bin/env bash
# yadm bootstrap – idempotent; supports macOS, Debian (apt) and Arch (pacman).
set -euo pipefail

PKG_DIR="$HOME/.config/yadm/packages"

log() { printf '\n==> %s\n' "$*"; }
have() { command -v "$1" >/dev/null 2>&1; }

distro_id() {
  if [ -r /etc/os-release ]; then
    # shellcheck disable=SC1091
    . /etc/os-release
    echo "${ID:-unknown} ${ID_LIKE:-}"
  fi
}

install_macos() {
  if ! have brew; then
    log "Installing Homebrew"
    /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
  fi
  for prefix in /opt/homebrew /usr/local; do
    if [ -x "$prefix/bin/brew" ]; then
      eval "$("$prefix/bin/brew" shellenv)"
      break
    fi
  done

  local brewfile="$HOME/.config/homebrew/Brewfile"
  if [ -f "$brewfile" ]; then
    log "Installing Homebrew bundle"
    brew bundle --file "$brewfile"
  fi
}

install_linux() {
  local ids list
  ids=$(distro_id)
  case " $ids " in
    *" arch "* | *" archlinux "*)
      list="$PKG_DIR/arch.txt"
      log "Installing packages with pacman"
      # shellcheck disable=SC2046
      sudo pacman -Syu --needed --noconfirm $(grep -vE '^\s*(#|$)' "$list")
      ;;
    *" debian "* | *" ubuntu "*)
      list="$PKG_DIR/debian.txt"
      log "Installing packages with apt"
      sudo apt-get update
      # Some packages (e.g. eza on older releases) may be missing; install individually.
      while read -r pkg; do
        [ -z "$pkg" ] && continue
        sudo apt-get install -y "$pkg" || echo "WARN: could not install $pkg"
      done < <(grep -vE '^\s*(#|$)' "$list")
      ;;
    *)
      echo "Unsupported distribution: $ids" >&2
      return 1
      ;;
  esac
}

install_starship() {
  if ! have starship; then
    log "Installing starship"
    mkdir -p "$HOME/.local/bin"
    curl -fsSL https://starship.rs/install.sh | sh -s -- --yes --bin-dir "$HOME/.local/bin"
  fi
}

set_default_shell() {
  local zsh_path
  zsh_path=$(command -v zsh || true)
  [ -n "$zsh_path" ] || return 0
  if [ "$(basename "${SHELL:-}")" != "zsh" ]; then
    log "Changing login shell to zsh"
    grep -qx "$zsh_path" /etc/shells || echo "$zsh_path" | sudo tee -a /etc/shells >/dev/null
    chsh -s "$zsh_path" || echo "WARN: chsh failed, change the shell manually"
  fi
}

case "$(uname -s)" in
  Darwin) install_macos ;;
  Linux) install_linux ;;
  *) echo "Unsupported OS: $(uname -s)" >&2; exit 1 ;;
esac

install_starship
set_default_shell

log "Applying yadm alternates"
yadm alt

log "Finished. Open a new shell (zinit installs its plugins on first start)."
