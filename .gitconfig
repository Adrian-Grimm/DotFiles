[user]
	name = Adrian-Grimm
	email = mail@adrian-grimm.net
[credential]
	username = Adrian-Grimm
[core]
	autocrlf = false
	eol = lf
	editor = nvim
	pager = delta
[init]
	defaultBranch = main
[interactive]
	diffFilter = delta --color-only
[delta]
	navigate = true
	dark = true
	line-numbers = true
[diff]
	colorMoved = default
[merge]
	conflictstyle = zdiff3
	tool = smerge
[mergetool "smerge"]
	cmd = smerge mergetool \"$BASE\" \"$LOCAL\" \"$REMOTE\" -o \"$MERGED\"
	trustExitCode = true
[pull]
	rebase = true
[push]
	autoSetupRemote = true
[rerere]
	enabled = true
[include]
	path = ~/.gitconfig.local
